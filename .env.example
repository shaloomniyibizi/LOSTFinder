# Copy to .env and fill in real values. .env is git-ignored.
SECRET_KEY=change-me
DEBUG=True

# sqlite (default) or postgresql
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Machine learning: models in ml/artifacts/, API used by fetch_api_data
ML_ENABLED=True
LOSTFINDER_API_URL=http://127.0.0.1:8000/api/v1/
